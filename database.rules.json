{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {
        "hostSeen": {
          ".read": true,
          ".write": true,
          ".validate": "newData.val() == now"
        },

        "teams": {
          ".read": true,

          "$teamId": {
            ".write": true,
            ".validate": "newData.hasChildren(['name', 'members', 'answer', 'locked'])",

            "name":     { ".validate": "newData.isString() && newData.val().length <= 40" },
            "members":  { ".validate": "newData.isString() && newData.val().length <= 200" },
            "answer":   { ".validate": "newData.isString() && newData.val().length <= 300" },
            "locked":   { ".validate": "newData.isBoolean()" },
            "buzzedAt": { ".validate": "newData.val() == now" },

            "score":    { ".validate": "newData.isNumber()" },
            "wager":    { ".validate": "newData.isNumber()" },

            "buzzer":   { ".validate": "newData.isString() && newData.val().length <= 40" },
            "ready":    { ".validate": "newData.isBoolean()" },
            "frozen":   { ".validate": "newData.isBoolean()" },

            "$other":   { ".validate": false }
          }
        },

        "game": {
          ".read": true,
          ".write": true,

          "pick": {
            ".validate": "newData.hasChildren(['team', 'cat', 'row']) && newData.child('team').val() == root.child('rooms').child($code).child('game').child('turn').val() && newData.child('cat').isNumber() && newData.child('row').isNumber()"
          }
        }
      }
    }
  }
}
